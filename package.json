{
  "name": "raumplaner-dachgeschoss",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "start": "concurrently -k -n server,web -c blue,green \"tsx watch server/index.ts\" \"vite --open\"",
    "dev": "npm start",
    "build": "tsc --noEmit -p . && vite build",
    "serve": "vite build && tsx server/index.ts --prod",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p .",
    "startprojekt": "tsx scripts/generate-startprojekt.ts"
  },
  "dependencies": {
    "@react-three/drei": "^9.117.3",
    "@react-three/fiber": "^8.17.10",
    "cheerio": "^1.0.0",
    "idb-keyval": "^6.2.1",
    "immer": "^10.1.1",
    "jspdf": "^2.5.2",
    "pdfjs-dist": "^4.8.69",
    "polygon-clipping": "^0.15.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.170.0",
    "zustand": "^5.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.170.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.5"
  },
  "optionalDependencies": {
    "playwright": "1.63.0"
  }
}
